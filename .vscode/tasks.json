{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lexer",
            "type": "shell",
            "command": "win_flex -o lexer/lex.yy.cpp lexer/lexer.l; if ($LASTEXITCODE -eq 0) { g++ lexer/lex.yy.cpp lexer/extension/logger/Logger.cpp lexer/extension/buffer/Buffer.cpp -o lexer/lexer.exe 2>&1 }",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run lexer",
            "type": "shell",
            "command": ".\\lexer\\lexer.exe",
            "dependsOn": "Build lexer",
            "problemMatcher": []
        },
        {
            "label": "Test all lexer",
            "type": "shell",
            "command": "Get-ChildItem tests\\lexer\\*.txt | ForEach-Object { Write-Host \"`n=== $($_.Name) ===\"; Get-Content $_.FullName | .\\lexer\\lexer.exe }",
            "dependsOn": "Build lexer",
            "problemMatcher": []
        }
    ]
}