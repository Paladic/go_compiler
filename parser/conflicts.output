  253                   | interface_element

  254 interface_element: IDENTIFIER function_signature
  255                  | type_terms

  256 type_terms: type_term
  257           | type_terms "|" type_term

  258 type_term: type
  259          | "~" type

  260 function_type: KW_FUNC function_signature

  261 channel_type: chan_prefix type
