Грамматика

    0 $accept: program $end

    1 program: package_clause ";" imports declarations

    2 package_clause: KW_PACKAGE IDENTIFIER

    3 imports: ε
    4        | imports import_declaration ";"

    5 import_declaration: KW_IMPORT import_spec
    6                   | KW_IMPORT "(" import_spec_list ")"

    7 import_spec_list: ε
    8                 | import_spec ";" import_spec_list
    9                 | import_spec

   10 import_spec: import_path
   11            | "." import_path
   12            | IDENTIFIER import_path

   13 import_path: STRING_LITERAL
   14            | RAW_STRING_LITERAL

   15 declarations: ε
   16             | declarations top_level_declaration ";"

   17 top_level_declaration: declaration
   18                      | function_declaration
   19                      | method_declaration

   20 declaration: variable_declaration
   21            | constant_declaration
   22            | type_declaration

   23 expression: logical_or_expression

   24 logical_or_expression: logical_and_expression
   25                      | logical_or_expression "||" logical_and_expression

   26 logical_and_expression: comparison_expression
   27                       | logical_and_expression "&&" comparison_expression

   28 comparison_expression: additive_expression
   29                      | comparison_expression "==" additive_expression
   30                      | comparison_expression "!=" additive_expression
   31                      | comparison_expression "<" additive_expression
   32                      | comparison_expression "<=" additive_expression
   33                      | comparison_expression ">" additive_expression
   34                      | comparison_expression ">=" additive_expression

   35 additive_expression: multiplicative_expression
   36                    | additive_expression "+" multiplicative_expression
   37                    | additive_expression "-" multiplicative_expression
   38                    | additive_expression "|" multiplicative_expression
   39                    | additive_expression "^" multiplicative_expression

   40 multiplicative_expression: unary_expression
   41                          | multiplicative_expression "*" unary_expression
   42                          | multiplicative_expression "/" unary_expression
   43                          | multiplicative_expression "%" unary_expression
   44                          | multiplicative_expression "<<" unary_expression
   45                          | multiplicative_expression ">>" unary_expression
   46                          | multiplicative_expression "&" unary_expression
   47                          | multiplicative_expression "&^" unary_expression

   48 unary_expression: primary_expression
   49                 | "+" unary_expression
   50                 | "-" unary_expression
   51                 | "!" unary_expression
   52                 | "^" unary_expression
   53                 | "*" unary_expression
   54                 | "&" unary_expression
   55                 | "<-" unary_expression

   56 primary_expression: operand
   57                   | primary_expression "." IDENTIFIER
   58                   | primary_expression arguments
   59                   | primary_expression "[" bracket_argument_list "]"
   60                   | primary_expression "[" optional_expression ":" optional_expression "]"
   61                   | primary_expression "[" optional_expression ":" expression ":" expression "]"
   62                   | primary_expression type_assertion
   63                   | primary_expression literal_value
   64                   | non_name_type "(" expression optional_trailing_comma ")"

   65 operand: literal
   66        | IDENTIFIER
   67        | "(" expression ")"

   68 literal: integer_literal
   69        | float_literal
   70        | imaginary_literal
   71        | rune_literal
   72        | string_literal
   73        | composite_literal
   74        | function_literal

   75 integer_literal: DECIMAL_LITERAL
   76                | BINARY_LITERAL
   77                | OCTAL_LITERAL
   78                | HEX_LITERAL

   79 float_literal: FLOAT_LITERAL
   80              | HEX_FLOAT_LITERAL

   81 imaginary_literal: IMAGINARY_LITERAL

   82 rune_literal: RUNE_LITERAL

   83 string_literal: STRING_LITERAL
   84               | RAW_STRING_LITERAL

   85 arguments: "(" ")"
   86          | "(" expression argument_expression_tail ")"
   87          | "(" non_name_type argument_type_tail ")"

   88 argument_expression_tail: ε
   89                         | ","
   90                         | "..."
   91                         | "..." ","
   92                         | "," expression argument_expression_tail

   93 argument_type_tail: ε
   94                   | ","
   95                   | "..."
   96                   | "..." ","
   97                   | "," expression argument_expression_tail

   98 bracket_argument_list: bracket_argument
   99                      | bracket_argument_list "," bracket_argument
  100                      | bracket_argument_list ","

  101 bracket_argument: expression
  102                 | non_name_type

  103 non_name_type: slice_type
  104              | array_type
  105              | map_type
  106              | struct_type
  107              | interface_type
  108              | function_type
  109              | channel_type

  110 optional_trailing_comma: ε
  111                        | ","

  112 optional_expression: ε
  113                    | expression

  114 type_assertion: "." "(" type ")"

  115 composite_literal: composite_literal_type literal_value

  116 composite_literal_type: array_type
  117                       | slice_type
  118                       | map_type
  119                       | struct_type
  120                       | "[" "..." "]" type

  121 literal_value: "{" "}"
  122              | "{" literal_elements "}"
  123              | "{" literal_elements "," "}"

  124 literal_elements: literal_element
  125                 | literal_elements "," literal_element

  126 literal_element: literal_element_value
  127                | literal_key ":" literal_element_value

  128 literal_element_value: expression
  129                      | literal_value

  130 literal_key: expression
  131            | literal_value

  132 function_literal: KW_FUNC function_signature function_body

  133 if_statement: KW_IF expression block optional_else
  134             | KW_IF optional_simple_statement ";" expression block optional_else

  135 optional_else: ε
  136              | KW_ELSE block
  137              | KW_ELSE if_statement

  138 for_statement: KW_FOR block
  139              | KW_FOR expression block
  140              | KW_FOR for_clause block
  141              | KW_FOR range_clause block

  142 for_clause: optional_simple_statement ";" optional_expression ";" optional_simple_statement

  143 optional_simple_statement: ε
  144                          | simple_statement

  145 range_clause: KW_RANGE expression
  146             | expression_list "=" KW_RANGE expression
  147             | expression_list ":=" KW_RANGE expression

  148 switch_statement: expression_switch_statement
  149                 | type_switch_statement

  150 expression_switch_statement: KW_SWITCH expression_switch_header "{" expression_cases "}"

  151 expression_switch_header: ε
  152                         | expression
  153                         | simple_statement ";" optional_expression

  154 expression_cases: ε
  155                 | expression_cases expression_case_clause

  156 expression_case_clause: KW_CASE expression_list ":" statement_list
  157                       | KW_DEFAULT ":" statement_list

  158 type_switch_statement: KW_SWITCH type_switch_guard "{" type_cases "}"
  159                      | KW_SWITCH simple_statement ";" type_switch_guard "{" type_cases "}"

  160 type_switch_guard: primary_expression "." "(" KW_TYPE ")"
  161                  | IDENTIFIER ":=" primary_expression "." "(" KW_TYPE ")"

  162 type_cases: ε
  163           | type_cases type_case_clause

  164 type_case_clause: KW_CASE type_case_list ":" statement_list
  165                 | KW_DEFAULT ":" statement_list

  166 type_case_list: type
  167               | type_case_list "," type

  168 select_statement: KW_SELECT "{" select_cases "}"

  169 select_cases: ε
  170             | select_cases select_case

  171 select_case: KW_CASE communication_clause ":" statement_list
  172            | KW_DEFAULT ":" statement_list

  173 communication_clause: send_statement
  174                     | expression
  175                     | expression_list "=" expression
  176                     | expression_list ":=" expression

  177 send_statement: expression "<-" expression

  178 variable_declaration: KW_VAR variable_spec
  179                     | KW_VAR "(" variable_spec_list ")"

  180 variable_spec_list: ε
  181                   | variable_spec ";" variable_spec_list
  182                   | variable_spec

  183 variable_spec: identifier_list type
  184              | identifier_list type "=" expression_list
  185              | identifier_list "=" expression_list

  186 constant_declaration: KW_CONST initialized_constant_spec
  187                     | KW_CONST "(" constant_spec_list ")"

  188 constant_spec_list: ε
  189                   | initialized_constant_spec constant_spec_list_tail

  190 constant_spec_list_tail: ε
  191                        | ";"
  192                        | ";" constant_spec constant_spec_list_tail

  193 constant_spec: initialized_constant_spec
  194              | identifier_list

  195 initialized_constant_spec: identifier_list type "=" expression_list
  196                          | identifier_list "=" expression_list

  197 type_declaration: KW_TYPE type_spec
  198                 | KW_TYPE "(" type_spec_list ")"

  199 type_spec_list: ε
  200               | type_spec ";" type_spec_list
  201               | type_spec

  202 type_spec: IDENTIFIER type
  203          | IDENTIFIER "=" type
  204          | IDENTIFIER type_parameters type
  205          | IDENTIFIER type_parameters "=" type

  206 type: type_name
  207     | type_name type_arguments
  208     | pointer_type
  209     | array_type
  210     | slice_type
  211     | map_type
  212     | struct_type
  213     | interface_type
  214     | function_type
  215     | channel_type
  216     | "(" type ")"

  217 type_name: IDENTIFIER
  218          | IDENTIFIER "." IDENTIFIER

  219 type_arguments: "[" type_list "]"
  220               | "[" type_list "," "]"

  221 type_list: type
  222          | type_list "," type

  223 type_parameters: "[" type_parameter_list "]"

  224 type_parameter_list: IDENTIFIER type_parameter_after_name

  225 type_parameter_after_name: type_constraint type_parameter_after_constraint
  226                          | "," type_parameter_list

  227 type_parameter_after_constraint: ε
  228                                | ","
  229                                | "," type_parameter_list

  230 type_constraint: type

  231 array_type: "[" expression "]" type

  232 slice_type: "[" "]" type

  233 pointer_type: "*" type

  234 map_type: KW_MAP "[" type "]" type

  235 struct_type: KW_STRUCT "{" field_declarations "}"

  236 field_declarations: ε
  237                   | field_declaration ";" field_declarations
  238                   | field_declaration

  239 field_declaration: identifier_list type optional_struct_tag
  240                  | embedded_field optional_struct_tag

  241 embedded_field: type_name
  242               | IDENTIFIER type_arguments
  243               | IDENTIFIER "." IDENTIFIER type_arguments
  244               | "*" type_name
  245               | "*" IDENTIFIER type_arguments
  246               | "*" IDENTIFIER "." IDENTIFIER type_arguments

  247 optional_struct_tag: ε
  248                    | STRING_LITERAL
  249                    | RAW_STRING_LITERAL

  250 interface_type: KW_INTERFACE "{" interface_elements "}"

  251 interface_elements: ε
