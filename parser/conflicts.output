  292                   | struct_type
  293                   | interface_type
  294                   | function_type
  295                   | channel_type

  296 function_body: block

  297 method_declaration: KW_FUNC receiver IDENTIFIER function_signature function_body
  298                   | KW_FUNC receiver IDENTIFIER function_signature
  299                   | KW_FUNC receiver IDENTIFIER type_parameters function_signature function_body
  300                   | KW_FUNC receiver IDENTIFIER type_parameters function_signature

  301 receiver: "(" type_name ")"
