  305         | "(" IDENTIFIER type_name ")"
  306         | "(" IDENTIFIER type_name type_arguments ")"
  307         | "(" IDENTIFIER "*" type_name ")"
  308         | "(" IDENTIFIER "*" type_name type_arguments ")"

  309 block: "{" statement_list "}"

  310 statement_list: ε
  311               | ";" statement_list
  312               | statement ";" statement_list
  313               | statement

  314 statement: declaration_statement
  315          | simple_statement
